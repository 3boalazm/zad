 Client-->App[Express app]
 App-->Auth[Auth router]
 App-->W[Worship router]
 App-->Sync[Sync router]
 App-->Lib[Library proxy]
 Auth-->DB[(PostgreSQL)]
 W-->DB
 Sync-->DB
 Lib-->H[HadeethEnc]
