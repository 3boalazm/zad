ْ خَشِىَ رَبَّهُۥ"],[99,1,599,"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"],[99,2,599,"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"],[99,3,599,"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"],[99,4,599,"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"],[99,5,599,"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"],[99,6,599,"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"],[99,7,599,"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"],[99,8,599,"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"],[100,1,599,"وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"],[100,2,599,"فَٱلْمُورِيَـٰتِ قَدْحًا"],[100,3,599,"فَٱلْمُغِيرَٰتِ صُبْحًا"],[100,4,599,"فَأَثَرْنَ بِهِۦ نَقْعًا"],[100,5,599,"فَوَسَطْنَ بِهِۦ جَمْعًا"],[100,6,599,"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"],[100,7,599,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"],[100,8,599,"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"],[100,9,599,"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"],[100,10,600,"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"],[100,11,600,"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"],[101,1,600,"ٱلْقَارِعَةُ"],[101,2,600,"مَا ٱلْقَارِعَةُ"],[101,3,600,"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"],[101,4,600,"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"],[101,5,600,"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"],[101,6,600,"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"],[101,7,600,"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"],[101,8,600,"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"],[101,9,600,"فَأُمُّهُۥ هَاوِيَةٌ"],[101,10,600,"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"],[101,11,600,"نَارٌ حَامِيَةٌۢ"],[102,1,600,"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"],[102,2,600,"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"],[102,3,600,"كَلَّا سَوْفَ تَعْلَمُونَ"],[102,4,600,"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"],[102,5,600,"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"],[102,6,600,"لَتَرَوُنَّ ٱلْجَحِيمَ"],[102,7,600,"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"],[102,8,600,"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"],[103,1,601,"وَٱلْعَصْرِ"],[103,2,601,"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"],[103,3,601,"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"],[104,1,601,"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"],[104,2,601,"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"],[104,3,601,"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"],[104,4,601,"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"],[104,5,601,"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"],[104,6,601,"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"],[104,7,601,"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"],[104,8,601,"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"],[104,9,601,"فِى عَمَدٍ مُّمَدَّدَةٍۭ"],[105,1,601,"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"],[105,2,601,"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"],[105,3,601,"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"],[105,4,601,"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"],[105,5,601,"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"],[106,1,602,"لِإِيلَـٰفِ قُرَيْشٍ"],[106,2,602,"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"],[106,3,602,"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"],[106,4,602,"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"],[107,1,602,"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"],[107,2,602,"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"],[107,3,602,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"],[107,4,602,"فَوَيْلٌ لِّلْمُصَلِّينَ"],[107,5,602,"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"],[107,6,602,"ٱلَّذِينَ هُمْ يُرَآءُونَ"],[107,7,602,"وَيَمْنَعُونَ ٱلْمَاعُونَ"],[108,1,602,"إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"],[108,2,602,"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"],[108,3,602,"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"],[109,1,603,"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"],[109,2,603,"لَآ أَعْبُدُ مَا تَعْبُدُونَ"],[109,3,603,"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"],[109,4,603,"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"],[109,5,603,"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"],[109,6,603,"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"],[110,1,603,"إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"],[110,2,603,"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا"],[110,3,603,"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"],[111,1,603,"تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"],[111,2,603,"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"],[111,3,603,"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"],[111,4,603,"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"],[111,5,603,"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"],[112,1,604,"قُلْ هُوَ ٱللَّهُ أَحَدٌ"],[112,2,604,"ٱللَّهُ ٱلصَّمَدُ"],[112,3,604,"لَمْ يَلِدْ وَلَمْ يُولَدْ"],[112,4,604,"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"],[113,1,604,"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"],[113,2,604,"مِن شَرِّ مَا خَلَقَ"],[113,3,604,"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"],[113,4,604,"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"],[113,5,604,"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"],[114,1,604,"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"],[114,2,604,"مَلِكِ ٱلنَّاسِ"],[114,3,604,"إِلَـٰهِ ٱلنَّاسِ"],[114,4,604,"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"],[114,5,604,"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"],[114,6,604,"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"]]}