# ZAD API — Environment Variables
# Sprint Z5: Auth/Sessions
# Copy this file to .env — NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4010
NODE_ENV=development

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# ⚠️  URL-encode password if it contains special chars (@ / + # etc.)
#     python3 -c "import urllib.parse; print(urllib.parse.quote('RAW_PASS', safe=''))"
# DATABASE_URL=postgresql://zad_app:ENCODED_PASSWORD@127.0.0.1:55432/zad

# SSL: false = plain TCP (Docker/local). true = managed cloud PG (RDS/Supabase).
DB_SSL=false

# ── Auth (Z5) ─────────────────────────────────────────────────────────────────
# No JWT secret needed — sessions are opaque tokens stored in HttpOnly cookies.
# Session tokens: 32 random bytes hex, SHA-256 hash stored in DB.
# Session duration: 30 days (hardcoded in src/auth/session.ts).

# ── Push Notifications (Z6+) ─────────────────────────────────────────────────
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=

# ── AI Proxy (Vercel — not duplicated here) ───────────────────────────────────
# GROQ_API_KEY is managed via Vercel environment — do NOT add here.
